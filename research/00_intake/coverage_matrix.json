    { "number": 14, "step_verbatim": "Amend a PO upward and revalidate budget." },
    { "number": 15, "step_verbatim": "Cancel or close a PO and release unused commitment." },
    { "number": 16, "step_verbatim": "Process a budget revision with version history." },
    { "number": 17, "step_verbatim": "Show project, WBS and budget-head dashboards." },
    { "number": 18, "step_verbatim": "Demonstrate project completion review." },
    { "number": 19, "step_verbatim": "Create a capitalisation request." },
