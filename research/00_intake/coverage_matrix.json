    { "number": 23, "step_verbatim": "Configure a Zoho ERP connection profile through the setup wizard." },
    { "number": 24, "step_verbatim": "Complete OAuth authorisation or demonstrate the full flow using a controlled mock where live credentials are unavailable." },
