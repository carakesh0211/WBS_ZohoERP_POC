    { "number": 27, "step_verbatim": "Run module-level connectivity tests." },
    { "number": 28, "step_verbatim": "Configure at least one master-data mapping and one transaction-line mapping." },
    { "number": 29, "step_verbatim": "Perform an initial vendor, item, location and Chart of Accounts sync." },
